# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Never commit `.env`.
# The api reads this file; docker compose reads it for the infra containers.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=trustone
POSTGRES_USER=trustone
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST_PORT=5433
# Connection string used by the api and the migration runner
DATABASE_URL=postgres://trustone:change-me-local-only@127.0.0.1:5433/trustone

# --- MinIO (docker compose) ---
MINIO_ROOT_USER=trustone-minio
MINIO_ROOT_PASSWORD=change-me-local-only-minio
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- Object storage as seen by the api (S3-compatible) ---
STORAGE_ENDPOINT=127.0.0.1
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=trustone-minio
STORAGE_SECRET_KEY=change-me-local-only-minio
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BUCKET=trustone-public
STORAGE_PRIVATE_BUCKET=trustone-private
# Base URL browsers use to load public catalog images (proxy/CDN in production)
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000/trustone-public
# Create buckets + public-read policy on startup (development convenience)
STORAGE_AUTO_CREATE_BUCKETS=true
STORAGE_PRESIGNED_TTL_SECONDS=300

# --- API ---
API_PORT=4000
AUTH_SESSION_TTL_HOURS=12
# Express trust proxy (real client IP for rate limiting behind the web BFF / nginx)
TRUST_PROXY=loopback
UPLOAD_IMAGE_MAX_MB=5
UPLOAD_DOCUMENT_MAX_MB=20
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# The web frontend (trustone-web) has its own .env.local.
